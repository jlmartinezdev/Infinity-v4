APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Zona horaria (UTC-3: America/Argentina/Buenos_Aires, America/Asuncion para Paraguay UTC-4)
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Backup BD (MySQL/MariaDB): ruta a mysqldump si no está en el PATH (ej. XAMPP en Windows)
# MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe

# Backup BD → Google Drive (OAuth Desktop + refresh token)
# BACKUP_DRIVE_ENABLED=false
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_FOLDER_ID=
# Vacío = loopback de escritorio (http://127.0.0.1:8765/), igual que php artisan backup:drive-auth.
# Solo definí esto si el cliente OAuth es tipo Aplicación web:
# GOOGLE_DRIVE_REDIRECT_URI="${APP_URL}/configuracion/backup-bd/drive/callback"
# BACKUP_DRIVE_KEEP=14

# Google Maps JavaScript API (panel web + app Staff WebView vía GET /api/v1/staff/config/maps)
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_MAP_ID=

# App Interplus Clientes 3.2 — portal/v1 (flags / pago online / referidos)
# PORTAL_PAGO_ONLINE_CHECKOUT_URL=https://checkout.ejemplo.com/session?cliente={cliente_id}
# PORTAL_PAGO_ONLINE_PROVIDER=bancard
# PORTAL_FLAG_PAGO_ONLINE=auto
# PORTAL_FLAG_PAGO_TIGO=coming_soon
# PORTAL_FLAG_PAGO_TRANSFERENCIA=coming_soon
# PORTAL_FLAG_PAGO_QR=hidden
# PORTAL_TIGO_PHONE=0981714322
# PORTAL_TIGO_ALIAS=Interplus
# PORTAL_BANK_NAME=
# PORTAL_BANK_ACCOUNT_NUMBER=

# TPago / Bancard (links de pago + callback)
# Callback a pegar en el portal TPago: {APP_URL}/api/v1/webhooks/tpago
# TPAGO_ENABLED=false
# TPAGO_ENV=sandbox
# TPAGO_PUBLIC_KEY=
# TPAGO_PRIVATE_KEY=
# TPAGO_COMMERCE_CODE=
# TPAGO_BRANCH_CODE=
# TPAGO_CALLBACK_URL=
# TPAGO_CALLBACK_USER=tpago_callback
# TPAGO_CALLBACK_PASSWORD=
# TPAGO_VERIFY_IP=false
# TPAGO_ALLOWED_IPS=190.128.218.209,190.128.232.10,190.104.129.98,200.85.46.226
# PORTAL_FLAG_INTERPLUS_IA=enabled
# PORTAL_FLAG_REFERIDOS=enabled
# PORTAL_REFERIDOS_PUNTOS_ALTA=50

# Play Integrity (Staff + Clientes) — arrancar en false (log-only)
# Mismo Cloud / misma service account para com.isp.staff y com.isp.clientes
# INTEGRITY_ENFORCE=false
# INTEGRITY_CLOUD_PROJECT_NUMBER=166400319630
# INTEGRITY_CREDENTIALS=/ruta/al/service-account-isp-staff-panel.json
# INTEGRITY_PACKAGE_NAME=com.isp.staff
# INTEGRITY_PACKAGE_CLIENTES=com.isp.clientes
# INTEGRITY_STAFF_DEVICE_NAME=android_staff_app
# INTEGRITY_CLIENTES_DEVICE_NAME=android_clientes_app
# INTEGRITY_ALLOWED_CERT_SHA256=
# INTEGRITY_ALLOWED_CERT_SHA256_CLIENTES=
# INTEGRITY_NONCE_TTL=120

# Loyalty / Premios (vencimiento FIFO de puntos)
# LOYALTY_DIAS_VENCIMIENTO=90
# LOYALTY_DIAS_VENCIMIENTO_BIENVENIDA=30
# LOYALTY_ALERTA_VENCIMIENTO_DIAS=30
# LOYALTY_LIMITE_CANJES_MES=1
# PORTAL_WHATSAPP_PAGOS=595971714322
# PORTAL_WHATSAPP_SOPORTE=595971714322

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# null = auto si APP_URL es https (ver AppServiceProvider). false = nunca Secure (solo HTTP local).
# SESSION_SECURE_COOKIE=
# SESSION_SAME_SITE=lax
#
# Sesión al cambiar de red / WiFi / proxy inverso:
# - Usá siempre el mismo host que APP_URL (no mezclar IP y nombre de equipo).
# - Detrás de nginx/Cloudflare con HTTPS, definí proxies de confianza:
# TRUSTED_PROXIES=*
# (ver config/trustedproxy.php)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MikroTik RouterOS API
# MIKROTIK_TIMEOUT=30
# MIKROTIK_SOCKET_TIMEOUT=60
# MIKROTIK_PORT=8728
# MIKROTIK_SSL=false

# GenieACS (TR-069 / CWMP) — CPE de cliente sin SSH. Ver docs/genieacs-tr069.md
# GENIEACS_ENABLED=false
# GENIEACS_NBI_URL=http://127.0.0.1:7557
# GENIEACS_NBI_USER=
# GENIEACS_NBI_PASSWORD=
# GENIEACS_TIMEOUT=20
# GENIEACS_ONLINE_GRACE_SECONDS=900

# SIFEN / Facturación electrónica Paraguay (e-Kuatia MT v150)
# SIFEN_AMBIENTE=test
# Envío local: sync | async (lote). En modo API lo define sifen-api.
# SIFEN_ENVIO_MODO=sync
# SIFEN_LOTE_ESPERA_INICIAL=30
# SIFEN_LOTE_INTERVALO=20
# SIFEN_LOTE_MAX_INTENTOS=30
# SIFEN_CERT_PATH=storage/sifen/cert/certificado.p12
# SIFEN_CERT_PASSWORD=
# SIFEN_CSC_ID=0001
# SIFEN_CSC_TOKEN=

# SIFEN API — microservicio sifen-api (emisión remota)
# SIFEN_API_ENABLED=false
# SIFEN_API_URL=http://sifen-api.test:8080
# SIFEN_API_TOKEN=
# SIFEN_API_TIMEOUT=900
# SIFEN_ENVIAR_CORREO=true

# WispHub API - importación de clientes (https://wisphub.net/api-docs)
# WISPHUB_API_KEY=tu_clave_api
# WISPHUB_BASE_URL=https://api.wisphub.net
# WISPHUB_BASE_URL=https://sandbox-api.wisphub.net

# WhatsApp Cloud API (Meta) � avisos salientes organizados
# WHATSAPP_ENABLED=false
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_VERIFY_TOKEN=infinity-wa-verify-cambiar
# WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v25.0
# WHATSAPP_DEFAULT_COUNTRY_CODE=595
# WHATSAPP_DEFAULT_TEMPLATE_LANGUAGE=es
# Webhook (estados de entrega): {APP_URL}/api/v1/webhooks/whatsapp
# Atenci�n conversacional = plugin N8N (dejar inbound/auto-reply en false)
# WHATSAPP_INBOUND_TICKETS=false
# WHATSAPP_AUTO_REPLY=false
# Agente IA N8N (plugin). Dejar WA_AGENT_ENABLED=false hasta que el webhook N8N responda 200.
# N8N_WA_AGENT_URL=http://200.59.9.117:5678/webhook/interplus-wa-agent
# N8N_WA_AGENT_SECRET=
# N8N_WA_AGENT_TIMEOUT_MS=25000
# WA_AGENT_ENABLED=false
# WA_AGENT_AUTO_SEND=false
# WA_AGENT_AUTO_TICKET=false
# WA_AGENT_HISTORIAL_LIMITE=12
# WA_AGENT_HISTORIAL_SOLO_HOY=true
# WA_AGENT_HISTORIAL_DIAS=1
# WA_AGENT_HORARIO_DESDE=09:00
# WA_AGENT_HORARIO_HASTA=18:00
# WA_AGENT_GEMINI_API_KEY=
# WA_AGENT_GEMINI_MODEL=gemini-3.6-flash
# Textos fijos de ventas (si vacío usa los de config/whatsapp.php agent.canned):
# WA_AGENT_TEXTO_BENEFICIOS=
# WA_AGENT_TEXTO_TRANSFERENCIA=
# WA_AGENT_TEXTO_CONDICIONES=
# WA_AGENT_FALLBACK_MESSAGE=Gracias por escribir a Interplus. Un asesor te responde en breve por este mismo WhatsApp.
# Eventos salientes
# WHATSAPP_EVENT_TICKET_ASIGNADO=true
# WHATSAPP_EVENT_TICKET_RESUELTO=false
# WHATSAPP_EVENT_FACTURA=false
# WHATSAPP_EVENT_ENLACE_CAIDO=false
# WHATSAPP_EVENT_RECIBO=false
# WHATSAPP_EVENT_SERVICIO_SUSPENDIDO=false
# WHATSAPP_EVENT_TV_VENCIMIENTO=true
# Ver docs/whatsapp-plantilla-tv-vencimiento.md
# WHATSAPP_TEMPLATE_TV_VENCIMIENTO=tv_cuenta_por_vencer
# WHATSAPP_TEMPLATE_TV_VENCIMIENTO_LANG=es
# WHATSAPP_EVENT_ISP_FAILOVER=true
# WHATSAPP_TEMPLATE_TICKET_ASIGNADO=
# WHATSAPP_TEMPLATE_TICKET_RESUELTO=ticket_resuelto
# WHATSAPP_TEMPLATE_TICKET_RESUELTO_LANG=es
# WHATSAPP_TEMPLATE_FACTURA=
# Ver docs/whatsapp-plantilla-factura-reclamo.md
# WHATSAPP_EVENT_FACTURA_RECLAMO=true
# WHATSAPP_TEMPLATE_FACTURA_RECLAMO=factura_reclamo_mora
# WHATSAPP_TEMPLATE_FACTURA_RECLAMO_LANG=es
# WHATSAPP_TEMPLATE_ENLACE_CAIDO=
# WHATSAPP_TEMPLATE_RECIBO=recibo_pago
# WHATSAPP_TEMPLATE_SERVICIO_SUSPENDIDO=servicio_suspendido_falta_pago
# WHATSAPP_TEMPLATE_SERVICIO_SUSPENDIDO_LANG=es
# Ver docs/whatsapp-plantilla-router-caido.md
# WHATSAPP_TEMPLATE_ROUTER_CAIDO=router_caido_ping
# WHATSAPP_TEMPLATE_ROUTER_CAIDO_LANG=es
# Ver docs/whatsapp-plantilla-isp-failover.md
# WHATSAPP_TEMPLATE_ISP_FAILOVER=isp_failover_salida
# WHATSAPP_TEMPLATE_ISP_FAILOVER_LANG=es
# Aviso staff "técnico en camino" (POST /api/v1/staff/avisos/en-camino)
# WHATSAPP_TEMPLATE_EN_CAMINO=staff_tecnico_en_camino_v1
# WHATSAPP_TEMPLATE_EN_CAMINO_LANG=es
# Alias: WHATSAPP_TEMPLATE_LANGUAGE=es
# Alias token: WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_EN_CAMINO_TRACKING=false
# WHATSAPP_STAFF_PHONES=3:0981123456,5:0971123456

# WHATSAPP_EVENT_ACCESO_APROBADO=false
# php artisan portal:avisar-acceso-aprobado {id} --clave=PLUS1234

# Firebase Cloud Messaging (push staff + app clientes)
# FCM_SERVER_KEY=
# FCM_STAFF_TOPIC=staff
# FCM_ANDROID_CHANNEL_ID=staff
# Canal app clientes 3.2.4+: interplus_avisos_v2 (no usar interplus_avisos: queda mudo)
# FCM_CLIENT_ANDROID_CHANNEL_ID=interplus_avisos_v2
