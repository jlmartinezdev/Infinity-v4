APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Zona horaria (UTC-3: America/Argentina/Buenos_Aires, America/Asuncion para Paraguay UTC-4)
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Backup BD (MySQL/MariaDB): ruta a mysqldump si no está en el PATH (ej. XAMPP en Windows)
# MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# null = auto si APP_URL es https (ver AppServiceProvider). false = nunca Secure (solo HTTP local).
# SESSION_SECURE_COOKIE=
# SESSION_SAME_SITE=lax
#
# Sesión al cambiar de red / WiFi / proxy inverso:
# - Usá siempre el mismo host que APP_URL (no mezclar IP y nombre de equipo).
# - Detrás de nginx/Cloudflare con HTTPS, definí proxies de confianza:
# TRUSTED_PROXIES=*
# (ver config/trustedproxy.php)

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# MikroTik RouterOS API
# MIKROTIK_TIMEOUT=30
# MIKROTIK_SOCKET_TIMEOUT=60
# MIKROTIK_PORT=8728
# MIKROTIK_SSL=false

# SIFEN / Facturación electrónica Paraguay (e-Kuatia MT v150)
# SIFEN_AMBIENTE=test
# SIFEN_CERT_PATH=storage/sifen/cert/certificado.p12
# SIFEN_CERT_PASSWORD=
# SIFEN_CSC_ID=0001
# SIFEN_CSC_TOKEN=

# SIFEN API — microservicio sifen-api (emisión remota)
# SIFEN_API_ENABLED=false
# SIFEN_API_URL=http://sifen-api.test:8080
# SIFEN_API_TOKEN=
# SIFEN_API_TIMEOUT=120

# WispHub API - importación de clientes (https://wisphub.net/api-docs)
# WISPHUB_API_KEY=tu_clave_api
# WISPHUB_BASE_URL=https://api.wisphub.net
# WISPHUB_BASE_URL=https://sandbox-api.wisphub.net
