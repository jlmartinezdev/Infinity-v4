{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "Red", "size": "Small", "weight": "Bolder", "isSubtle": true }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${actualizado}", "size": "Small", "isSubtle": true, "horizontalAlignment": "Right" }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${estadoTexto}",
      "size": "Large",
      "weight": "Bolder",
      "color": "${estadoColor}",
      "spacing": "Small",
      "wrap": true
    },
    {
      "type": "TextBlock",
      "text": "${estadoDetalle}",
      "size": "Small",
      "isSubtle": true,
      "spacing": "None",
      "wrap": true,
      "$when": "${estadoDetalle!=\"\"}"
    },

    {
      "type": "Container",
      "spacing": "Medium",
      "separator": true,
      "$when": "${$host.widgetSize==\"small\"}",
      "items": [
        {
          "type": "ColumnSet",
          "$data": "${tipos}",
          "spacing": "Small",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "Center",
              "items": [{ "type": "TextBlock", "text": "${etiqueta}", "size": "Small" }]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "$when": "${modo==\"conteo\"}",
              "items": [{ "type": "TextBlock", "text": "↑ ${online}", "size": "Small", "weight": "Bolder", "color": "Good" }]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "$when": "${modo==\"conteo\"}",
              "items": [{ "type": "TextBlock", "text": "↓ ${offline}", "size": "Small", "weight": "Bolder", "color": "${offlineColor}", "isSubtle": true }]
            },
            {
              "type": "Column",
              "width": "auto",
              "verticalContentAlignment": "Center",
              "$when": "${modo==\"sindato\"}",
              "items": [{ "type": "TextBlock", "text": "${texto}", "size": "Small", "isSubtle": true }]
            }
          ]
        }
      ]
    },

    {
      "type": "ColumnSet",
      "spacing": "Medium",
      "$when": "${$host.widgetSize!=\"small\"}",
      "columns": [
        {
          "type": "Column",
          "$data": "${tipos}",
          "width": "stretch",
          "style": "emphasis",
          "items": [
            { "type": "TextBlock", "text": "${etiqueta}", "size": "Small", "isSubtle": true },
            { "type": "TextBlock", "text": "${grande}", "size": "ExtraLarge", "weight": "Bolder", "color": "${grandeColor}", "spacing": "None" },
            { "type": "TextBlock", "text": "${detalle}", "size": "Small", "color": "${detalleColor}", "isSubtle": true, "spacing": "None", "wrap": true }
          ]
        }
      ]
    },

    {
      "type": "TextBlock",
      "text": "Equipos caídos",
      "size": "Small",
      "weight": "Bolder",
      "isSubtle": true,
      "spacing": "Medium",
      "separator": true,
      "$when": "${hayCaidas==\"si\" && $host.widgetSize!=\"small\"}"
    },
    {
      "type": "ColumnSet",
      "$data": "${caidas}",
      "spacing": "Small",
      "$when": "${$host.widgetSize==\"large\" || $index < 2}",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "${nombre}", "size": "Small", "weight": "Bolder", "maxLines": 1 },
            { "type": "TextBlock", "text": "${detalle}", "size": "Small", "isSubtle": true, "spacing": "None", "maxLines": 1 }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${hace}", "size": "Small", "weight": "Bolder", "color": "Attention", "horizontalAlignment": "Right" }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "${masMedium}",
      "size": "Small",
      "isSubtle": true,
      "spacing": "Small",
      "$when": "${masMedium!=\"\" && $host.widgetSize==\"medium\"}"
    },
    {
      "type": "TextBlock",
      "text": "${masLarge}",
      "size": "Small",
      "isSubtle": true,
      "spacing": "Small",
      "$when": "${masLarge!=\"\" && $host.widgetSize==\"large\"}"
    }
  ]
}
