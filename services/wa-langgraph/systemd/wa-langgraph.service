[Unit]
Description=Interplus WhatsApp LangGraph agent
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/infinity/infinity-v4/services/wa-langgraph
EnvironmentFile=-/home/infinity/infinity-v4/.env
Environment=PYTHONUNBUFFERED=1
Environment=WA_AGENT_TOOLS_BASE_URL=http://127.0.0.1/api/v1/wa-agent/tools
ExecStart=/home/infinity/infinity-v4/services/wa-langgraph/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8091
Restart=on-failure
RestartSec=3
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
